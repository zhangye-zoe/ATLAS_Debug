# =============================================================================
# Research model archive — code-only Git repository
# Purpose: keep source code, configurations, scripts, and documentation;
#          exclude datasets, generated outputs, model weights, and local files.
# Place this file at the ROOT of the old model project.
# =============================================================================

# 1. Data and intermediate features (at any directory depth)
**/data/
**/dataset/
**/datasets/
**/raw/
**/processed/
**/preprocessed/
**/interim/
**/intermediate/
**/features/
**/embeddings/
**/patches/
**/tiles/
**/splits/
**/cache/
**/.cache/

# 2. Experiments and generated results (at any directory depth)
**/results/
**/result/
**/outputs/
**/output/
**/output_v1/
**/output_v2/
**/runs/
**/run_logs/
**/logs/
**/checkpoints/
**/checkpoint/
**/weights/
**/models/saved/
**/predictions/
**/inference_outputs/
**/evaluations/
**/artifacts/
**/experiments_output/
**/tensorboard/
**/lightning_logs/
**/wandb/
**/mlruns/
**/mlartifacts/
**/ray_results/
**/profiler/
**/profiles/
**/debug/
**/tmp/
**/temp/
**/Monocle_prepare/
**/drawing/

